{
  "name": "vetpal-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Vet-Pal Animal Owner Appium automation (pages + tests)",
  "scripts": {
    "test": "npm run test:ios",
    "test:ios": "wdio run ./wdio.ios.conf.js",
    "test:android": "wdio run ./wdio.android.conf.js",
    "test:ios:signin": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.positive.test.js --spec ./tests/auth/signIn.negative.test.js",
    "test:ios:signup": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signUp.positive.test.js --spec ./tests/auth/signUp.negative.test.js",
    "test:ios:signup:positive": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signUp.positive.test.js",
    "test:ios:signup:negative": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signUp.negative.test.js",
    "test:ios:profile": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/createProfile.splash.test.js",
    "test:ios:positive": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.positive.test.js",
    "test:ios:negative": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.negative.test.js",
    "test:android:signin": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signIn.positive.test.js --spec ./tests/auth/signIn.negative.test.js",
    "test:android:negative": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signIn.negative.test.js",
    "test:ios:rt:vet": "wdio run ./wdio.ios.conf.js --spec ./tests/requestTreatment/vetPractice.positive.test.js",
    "test:ios:rt:vet:neg": "wdio run ./wdio.ios.conf.js --spec ./tests/requestTreatment/vetPractice.negative.test.js",
    "test:ios:rt:nearby": "wdio run ./wdio.ios.conf.js --spec ./tests/requestTreatment/nearbyRemedyStore.positive.test.js",
    "test:ios:rt:nearby:neg": "wdio run ./wdio.ios.conf.js --spec ./tests/requestTreatment/nearbyRemedyStore.negative.test.js",
    "test:ios:rt:horse": "node ./scripts/runRtCategory.js horse",
    "test:ios:rt:cattle": "node ./scripts/runRtCategory.js cattle",
    "test:ios:rt:sheep": "node ./scripts/runRtCategory.js sheep",
    "test:ios:rt:goat": "node ./scripts/runRtCategory.js goat",
    "test:ios:rt:deer": "node ./scripts/runRtCategory.js deer",
    "test:ios:rt:pig": "node ./scripts/runRtCategory.js pig",
    "test:ios:rt:poultry": "node ./scripts/runRtCategory.js poultry",
    "test:android:rt:vet": "wdio run ./wdio.android.conf.js --spec ./tests/requestTreatment/vetPractice.positive.test.js",
    "test:android:rt:nearby": "wdio run ./wdio.android.conf.js --spec ./tests/requestTreatment/nearbyRemedyStore.positive.test.js",
    "check:devices": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js",
    "check:devices:ios": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js ios",
    "check:devices:android": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js android",
    "report:catalog": "node -e \"const p=require('./project.config');const c=require('@mobile-automation/appium-core/utils/testReport').createTestReport(require(p.catalogPath),{displayName:p.displayName,reportBaseName:p.reportBaseName});c.writeCatalogHtml(p.reportsDir);\"",
    "report:open": "open ./reports/vetpal-report.html || xdg-open ./reports/vetpal-report.html",
    "report:catalog:open": "npm run report:catalog && (open ./reports/test-catalog.html || xdg-open ./reports/test-catalog.html)"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mobile-automation/appium-core": "file:../../framework"
  },
  "devDependencies": {
    "@wdio/cli": "^9.12.0",
    "@wdio/junit-reporter": "^9.12.0",
    "@wdio/local-runner": "^9.12.0",
    "@wdio/mocha-framework": "^9.12.0",
    "@wdio/spec-reporter": "^9.12.0",
    "dotenv": "^16.4.7",
    "webdriverio": "^9.12.0"
  }
}
