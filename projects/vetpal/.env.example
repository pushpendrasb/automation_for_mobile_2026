# Vet-Pal Animal Owner — test credentials (never commit .env)
# Generate this file with: npm run setup -- --project vetpal
# Do NOT copy another Mac's IOS_DEVICE_UDID or IOS_TEAM_ID.

# javascript | python — this framework runs JavaScript (WebdriverIO) today
AUTOMATION_SCRIPT_LANGUAGE=javascript

VETPAL_COUNTRY_CODE=+353
VETPAL_TEST_MOBILE=
VETPAL_TEST_PASSWORD=

VETPAL_INVALID_MOBILE=899999999
VETPAL_INVALID_PASSWORD=WrongPass!999
VETPAL_WRONG_PASSWORD=WrongPass!NotMine999
VETPAL_UNKNOWN_MOBILE=899999998

# After login — visible text on Home (comma-separated)
VETPAL_HOME_INDICATORS=VETPAL,Request Treatment,My Appointments,Dispensed Prescriptions,My Practices

# Sign In UI copy (from Login.js)
VETPAL_SIGN_IN_BUTTON=Sign In Now
VETPAL_MOBILE_BLANK_TOAST=Please enter mobile number
VETPAL_PASSWORD_BLANK_TOAST=Please enter password

# Sign Up — or edit projects/vetpal/data/signUpData.js
VETPAL_SIGNUP_EMAIL=
VETPAL_SIGNUP_COUNTRY_CODE=+91
VETPAL_SIGNUP_MOBILE=
VETPAL_SIGNUP_PASSWORD=
VETPAL_SIGNUP_CONFIRM_PASSWORD=
VETPAL_SIGNUP_OTP_WAIT_MS=30000
VETPAL_SIGNUP_OTP=
VETPAL_PROFILE_FIRST_NAME=
VETPAL_PROFILE_LAST_NAME=
VETPAL_PROFILE_ADDRESS_SEARCH=Dublin
VETPAL_PROFILE_COUNTY=Dublin
VETPAL_PROFILE_COUNTRY=IRELAND
VETPAL_PROFILE_POSTCODE=
VETPAL_PROFILE_COMPANY=
VETPAL_PROFILE_ANIMAL=equine
VETPAL_PROFILE_HERD=

# Request Treatment (Vet Practice / Nearby Remedy Store)
VET_PRACTICE_NAME=Dev Test Account-U
VET_PRACTICE_INDEX=0
REMEDY_STORE_NAME=Southwood Pharmacy
REMEDY_STORE_INDEX=0
BRANCH_INDEX=0
TREATMENT_REQUEST=demo treatment request

# iOS — fill via setup wizard on THIS Mac
IOS_DEVICE_UDID=
IOS_TEAM_ID=
IOS_BUNDLE_ID=ie.vetpal
IOS_APP_PATH=
IOS_XCODE_SIGNING_ID=Apple Development
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.0
IOS_REAL_PLATFORM_VERSION=

# Android
ANDROID_DEVICE_ID=
ANDROID_APP_PACKAGE=ie.vetpal
ANDROID_APP_ACTIVITY=
ANDROID_APP_PATH=

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_SHOW_XCODE_LOG=true
