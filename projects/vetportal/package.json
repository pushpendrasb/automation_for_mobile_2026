{
  "name": "vetportal-automation",
  "version": "1.0.0",
  "private": true,
  "description": "VetPortal Appium automation (pages + tests)",
  "scripts": {
    "setup": "node ../../scripts/setup-mac.js --project vetportal --skip-tools",
    "test": "npm run test:ios",
    "test:ios": "wdio run ./wdio.ios.conf.js",
    "test:android": "wdio run ./wdio.android.conf.js",
    "test:ios:smoke": "wdio run ./wdio.ios.conf.js --spec ./tests/smoke/launch.smoke.test.js",
    "test:android:smoke": "wdio run ./wdio.android.conf.js --spec ./tests/smoke/launch.smoke.test.js",
    "test:ios:signin": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.negative.test.js --spec ./tests/auth/signIn.positive.test.js",
    "test:ios:signin:positive": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.positive.test.js",
    "test:ios:signin:negative": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signIn.negative.test.js",
    "test:ios:signin:failure-demo": "wdio run ./wdio.ios.conf.js --spec ./tests/demo/signIn.wrongPassword.failure.demo.js",
    "test:ios:signup": "wdio run ./wdio.ios.conf.js --spec ./tests/auth/signUp.positive.test.js",
    "test:ios:signup:exact": "REG_EMAIL_UNIQUE=false wdio run ./wdio.ios.conf.js --spec ./tests/auth/signUp.positive.test.js",
    "test:ios:compose": "wdio run ./wdio.ios.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.negative.test.js --spec ./tests/prescriptions/composeScript.vetPractice.positive.test.js",
    "test:ios:compose:positive": "wdio run ./wdio.ios.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.positive.test.js",
    "test:ios:compose:negative": "wdio run ./wdio.ios.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.negative.test.js",
    "test:android:signin": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signIn.negative.test.js --spec ./tests/auth/signIn.positive.test.js",
    "test:android:signin:positive": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signIn.positive.test.js",
    "test:android:signin:negative": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signIn.negative.test.js",
    "test:android:signin:failure-demo": "wdio run ./wdio.android.conf.js --spec ./tests/demo/signIn.wrongPassword.failure.demo.js",
    "test:android:signup": "wdio run ./wdio.android.conf.js --spec ./tests/auth/signUp.positive.test.js",
    "test:android:signup:exact": "REG_EMAIL_UNIQUE=false wdio run ./wdio.android.conf.js --spec ./tests/auth/signUp.positive.test.js",
    "test:android:compose": "wdio run ./wdio.android.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.negative.test.js --spec ./tests/prescriptions/composeScript.vetPractice.positive.test.js",
    "test:android:compose:positive": "wdio run ./wdio.android.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.positive.test.js",
    "test:android:compose:negative": "wdio run ./wdio.android.conf.js --spec ./tests/prescriptions/composeScript.vetPractice.negative.test.js",
    "check:devices": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js",
    "check:devices:ios": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js ios",
    "check:devices:android": "AUTOMATION_PROJECT_ROOT=. node ../../framework/utils/checkDevices.js android",
    "report:open": "open ./reports/vetportal-report.html || xdg-open ./reports/vetportal-report.html"
  },
  "dashboard": {
    "runInputs": [
      {
        "key": "TEST_USER",
        "label": "Sign-in email",
        "type": "email",
        "placeholder": "vet assistant account email",
        "scripts": [
          "test:ios:signin",
          "test:ios:signin:positive",
          "test:ios:signin:negative",
          "test:ios:signin:failure-demo",
          "test:android:signin",
          "test:android:signin:positive",
          "test:android:signin:negative",
          "test:android:signin:failure-demo",
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:ios:compose:negative",
          "test:android:compose",
          "test:android:compose:positive",
          "test:android:compose:negative"
        ]
      },
      {
        "key": "TEST_PASSWORD",
        "label": "Sign-in password",
        "type": "password",
        "secret": true,
        "hint": "only the positive sign-in case uses it; negative cases use a wrong password on purpose",
        "scripts": [
          "test:ios:signin",
          "test:ios:signin:positive",
          "test:android:signin",
          "test:android:signin:positive",
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:ios:compose:negative",
          "test:android:compose",
          "test:android:compose:positive",
          "test:android:compose:negative"
        ]
      },
      {
        "key": "REG_EMAIL_BASE",
        "label": "Email",
        "type": "email",
        "placeholder": "pushpendra@appdesign.ie",
        "pattern": "[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "hint": "letters, digits, . _ - before the @ (the app rejects +)",
        "scripts": [
          "test:ios:signup",
          "test:ios:signup:exact",
          "test:android:signup",
          "test:android:signup:exact"
        ]
      },
      {
        "key": "REG_MOBILE",
        "label": "Mobile (+353)",
        "type": "tel",
        "placeholder": "8XXXXXXXX",
        "pattern": "8[0-9]{8}",
        "hint": "9 digits starting with 8, without +353",
        "scripts": [
          "test:ios:signup",
          "test:ios:signup:exact",
          "test:android:signup",
          "test:android:signup:exact"
        ]
      },
      {
        "key": "REG_EMAIL_UNIQUE",
        "label": "Type email exactly (no .reg timestamp)",
        "type": "checkbox",
        "checkedValue": "false",
        "pattern": "true|false",
        "scripts": [
          "test:ios:signup",
          "test:android:signup"
        ]
      },
      {
        "key": "COMPOSE_CLIENT_NAME",
        "label": "Client name",
        "type": "text",
        "placeholder": "Adelina Amara",
        "pattern": "[A-Za-z0-9 .'-]{2,60}",
        "hint": "existing client, as shown in the Client Name list",
        "scripts": [
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:ios:compose:negative",
          "test:android:compose",
          "test:android:compose:positive",
          "test:android:compose:negative"
        ]
      },
      {
        "key": "COMPOSE_ANIMAL",
        "label": "Animal category / type",
        "type": "text",
        "placeholder": "Horses - Horses",
        "pattern": "[A-Za-z0-9 ()/,.'-]{2,80}",
        "hint": "text of the Animal Category/ Type row, e.g. Horses - Horses",
        "scripts": [
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:ios:compose:negative",
          "test:android:compose",
          "test:android:compose:positive",
          "test:android:compose:negative"
        ]
      },
      {
        "key": "COMPOSE_MEDICINE_SEARCH",
        "label": "Medicine search",
        "type": "text",
        "placeholder": "blank = first drug in the list",
        "pattern": "[A-Za-z0-9 .%/()-]{1,60}",
        "scripts": [
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:android:compose",
          "test:android:compose:positive"
        ]
      },
      {
        "key": "COMPOSE_QUANTITY",
        "label": "Quantity",
        "type": "text",
        "placeholder": "1",
        "pattern": "[0-9]{1,3}(\\.[0-9]{1,2})?",
        "hint": "number, up to 2 decimals",
        "scripts": [
          "test:ios:compose",
          "test:ios:compose:positive",
          "test:android:compose",
          "test:android:compose:positive"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mobile-automation/appium-core": "file:../../framework"
  },
  "devDependencies": {
    "@wdio/cli": "^9.12.0",
    "@wdio/junit-reporter": "^9.12.0",
    "@wdio/local-runner": "^9.12.0",
    "@wdio/mocha-framework": "^9.12.0",
    "@wdio/spec-reporter": "^9.12.0",
    "dotenv": "^16.4.7",
    "expect-webdriverio": "^6.0.9",
    "webdriverio": "^9.12.0"
  }
}
