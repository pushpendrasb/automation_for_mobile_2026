# VetPortal — local secrets & device config (never commit .env)
# Copy via setup wizard: npm run setup -- --project vetportal

# javascript | typescript | python
AUTOMATION_SCRIPT_LANGUAGE=javascript

# Path / URL of the real app repo (used when writing automation scripts)
APP_SOURCE_PATH=/Users/pushpendrasb/Documents/React_Native/Vet_Portal/vetpal-vetuser
APP_SOURCE_REPO_URL=

# Sign In — vet assistant account (email + password)
TEST_USER=
TEST_PASSWORD=
# Optional overrides for negative Sign In cases
VETPORTAL_UNKNOWN_EMAIL=
VETPORTAL_MALFORMED_EMAIL=
VETPORTAL_WRONG_PASSWORD=

# Registration (required: password + Irish mobile, 9 digits starting with 8)
REG_PASSWORD=
REG_MOBILE=
# Optional overrides — defaults: Pushpendra / "" / Singh / pushpendra@appdesign.ie
# (a unique .reg<timestamp> is added to the email every run),
# Bachelor of Veterinary Science / 02/55 / "dublin" 2nd suggestion / D01 F5P2
REG_FIRST_NAME=
REG_MIDDLE_NAME=
REG_LAST_NAME=
REG_EMAIL_BASE=
# true (default) = add .reg<timestamp> so reruns never collide.
# false = type REG_EMAIL_BASE exactly (delete that account before each rerun).
# Same as running: npm run test:ios:signup:exact (the command line beats .env).
REG_EMAIL_UNIQUE=
REG_QUALIFICATION=
REG_VET_REG_NO=
REG_ADDRESS_SEARCH=
REG_ADDRESS_RESULT_INDEX=
REG_EIRCODE=

# iOS — leave UDID/TEAM blank until THIS Mac's device/account is known
IOS_DEVICE_UDID=
# Team ID (10 chars) from developer.apple.com → Membership details — NOT Xcode Accounts → Manage
IOS_TEAM_ID=
IOS_BUNDLE_ID=ie.vetpal.vet
IOS_APP_PATH=
IOS_XCODE_SIGNING_ID=Apple Development
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.0
IOS_REAL_PLATFORM_VERSION=

# Android
ANDROID_DEVICE_ID=
ANDROID_APP_PACKAGE=ie.vetpal.vet
ANDROID_APP_ACTIVITY=
ANDROID_APP_PATH=

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_SHOW_XCODE_LOG=true

# Compose New Script → Veterinary Practice (npm run test:ios:compose:practice[:positive|:negative])
# The positive case creates a real prescription.
COMPOSE_CLIENT_NAME=Adelina Amara
COMPOSE_ANIMAL=Horses - Horses
COMPOSE_HERD_ANIMAL=Cattle - Dairy
# Blank = first drug in the Drug Compendium list
COMPOSE_MEDICINE_SEARCH=
COMPOSE_QUANTITY=1
COMPOSE_ANIMAL_ID=Automation test animal
# Add Medicine: used only when the drug leaves the field empty.
# Withdrawal Period/Notes pick the first "Select" entry; the text is typed only
# if that list is empty. Empty Unit / Route take the first list entry.
COMPOSE_WITHDRAWAL_PERIOD=Automation test withdrawal period
COMPOSE_WITHDRAWAL_NOTES=Automation test withdrawal notes
COMPOSE_DOSAGE=1 ml
COMPOSE_RECOMMENDATION=Automation test recommendation
