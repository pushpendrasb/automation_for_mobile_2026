# RosKids — local secrets & device config (never commit .env)
# Generate with: npm run setup -- --project roskids
# Do NOT copy another Mac's IOS_DEVICE_UDID or IOS_TEAM_ID.

ROS_KIDS_TEST_EMAIL=
ROS_KIDS_TEST_PASSWORD=
ROS_KIDS_INVALID_EMAIL=invalid.user@example.com
ROS_KIDS_INVALID_PASSWORD=WrongPass!999
ROS_KIDS_WRONG_PASSWORD=WrongPass!NotMine999

# iOS — fill via setup wizard on THIS Mac
IOS_DEVICE_UDID=
IOS_TEAM_ID=
IOS_BUNDLE_ID=ie.myroskids
IOS_APP_PATH=
IOS_XCODE_SIGNING_ID=Apple Development

# iOS Simulator fallback (used when IOS_DEVICE_UDID is empty)
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.0
IOS_REAL_PLATFORM_VERSION=

# Android
ANDROID_DEVICE_ID=
ANDROID_APP_PACKAGE=ie.myroskids
ANDROID_APP_ACTIVITY=
ANDROID_APP_PATH=

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_SHOW_XCODE_LOG=true

# Book Service: target duration per weekday in slot dialog (minutes)
BOOK_SERVICE_SLOT_MINUTES=120
